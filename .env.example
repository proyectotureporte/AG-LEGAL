# Base de datos PostgreSQL (usuario exclusivo de la aplicación)
DATABASE_URL=postgresql://aglegal_user:CAMBIAR@localhost:5432/aglegal_db

# Aplicación
NODE_ENV=production
PORT=3004
APP_URL=https://ag-legal.com.co

# Administrador único. Guardar solo un hash Argon2id, nunca la contraseña.
ADMIN_USERNAME=administrador
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=1$CAMBIAR
AUTH_SECRET=CAMBIAR_POR_64_CARACTERES_ALEATORIOS

# Correo SMTP seguro
SMTP_HOST=sh12.hostdime.com.co
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=aglegal@restaurar.co
SMTP_PASSWORD=CAMBIAR_POR_LA_CLAVE_PRIVADA_DEL_BUZON
EMAIL_FROM=AG Legal <aglegal@restaurar.co>
FORM_NOTIFICATION_EMAIL=aglegal@restaurar.co
