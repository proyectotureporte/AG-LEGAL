aglegal.restaurar.co {
	log {
		output file /var/log/caddy/aglegal.log {
			roll_size 10MB
			roll_keep 10
		}
		format json
	}

	encode zstd gzip

	@hidden path /.env* /.git* /.htaccess /*.bak /*.sql /*.log /*.ini /*.config
	handle @hidden {
		respond 404
	}

	request_body {
		max_size 16KB
	}

	handle {
		reverse_proxy 127.0.0.1:4009 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	header {
		-Server
		-X-Powered-By
		-Via
	}
}
